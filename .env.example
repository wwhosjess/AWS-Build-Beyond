# Optional: rule-based fallback analysis runs when OpenAI is unavailable.
# Copy this file to .env for local development; never commit .env.
OPENAI_API_KEY=<your-openai-api-key>

# Telegram delivery settings
TELEGRAM_BOT_TOKEN=<your-telegram-bot-token>
TELEGRAM_CHAT_ID=<your-chat-id>
SENT_ARTICLES_TABLE=<your-dynamodb-table-name>
TELEGRAM_WEBHOOK_SECRET=<generate-a-random-secret>

# Optional daily briefing settings
DEFAULT_BRIEF_COUNT=3
TIMEZONE=Asia/Singapore
